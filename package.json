{
  "name": "dev-shell",
  "version": "0.2.0",
  "description": "A local browser workspace with a file manager, editor, terminal, and live preview.",
  "keywords": ["bun", "cli", "development", "terminal", "workspace"],
  "engines": { "bun": ">=1.3.5" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "files": ["index.ts", "workspace.html", "workspace.ts", "workspace.css"],
  "bin": { "dev-shell": "./index.ts" },
  "scripts": {
    "dev": "bun index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run typecheck && bun test"
  },
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  }
}
